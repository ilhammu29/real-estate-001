# =======================================================
# NENYAHOME ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development
# Add these variables to your Vercel Project Settings
# =======================================================

# --- SUPABASE DATABASE CONFIGURATION ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CLOUDFLARE R2 STORAGE CONFIGURATION ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=real-estate-assets
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Note: The application operates gracefully even without these variables
# using an automatic local/in-memory database and local file storage fallback.
